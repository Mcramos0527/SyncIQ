# SyncIQ — full environment variable reference.
#
# This file documents every var the MVP will eventually need, across all
# phases, so nobody has to go spelunking through code to figure out what to
# set. It is NOT loaded at runtime — Next.js only reads .env / .env.local /
# .env.production / .env.production.local (see those files, and the
# boilerplate's own convention: non-secret defaults live in the tracked
# .env, real secrets go in the gitignored .env.local).
#
# Nothing in this file is a real credential. Fill in .env.local as each
# integration comes online.

# ── Clerk (auth + organizations-as-workspaces) — Phase 0, already wired ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database — Phase 0 uses embedded PGlite, no value needed locally ──
# Point this at a real Supabase Postgres connection string once the
# customer POC is approved and a project exists. Drizzle doesn't care
# which Postgres it's talking to.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# ── Meta Ads OAuth — Phase 1 ──
# Create a Meta App at developers.facebook.com, add the Marketing API
# product, and use its App ID/Secret here.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/connections/meta/callback

# ── Google Ads / GA4 OAuth — Phase 1 ──
# Create an OAuth 2.0 client in Google Cloud Console (GA4 Data API +
# Google Ads API scopes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback
# No GA4_PROPERTY_ID here -- that's per-workspace, not a developer secret.
# It's auto-detected from the connected Google account's first GA4
# property via the Admin API (see GoogleOAuthClient.fetchPrimaryGa4PropertyId)
# and stored in platform_connections.account_id.

# ── Claude API — Phase 3 (proposals) + Phase 4 (synthetic panel) ──
# Sonnet drives analysis/proposals/calibration; Haiku scores the panel
# in batches of 50 personas per call (cost optimization — see CLAUDE.md).
ANTHROPIC_API_KEY=

# ── Hugging Face Inference API — Phase 4 (persona embeddings) ──
# Free tier, rate limited. Used for sentence-transformers/all-MiniLM-L6-v2.
HUGGINGFACE_API_TOKEN=

# ── Resend — welcome email after first data sync (onboarding UX) ──
RESEND_API_KEY=

# ── Upstash Redis — rate limiting / caching ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── n8n — workflow automation (WF1-WF5), self-hosted on Hetzner ──
# Shared secret so n8n's webhook calls into our API routes can be verified.
N8N_WEBHOOK_SECRET=

# ── Stripe — not yet integrated, not required for MVP scope. ──
# Test mode only until this actually gets built (see CLAUDE.md Deviations).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
